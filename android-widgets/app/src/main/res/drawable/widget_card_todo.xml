<?xml version="1.0" encoding="utf-8"?>
<!-- Premium widget card: rounded white body + a thin colored spine on the
     left edge, one accent color per widget (see colors.xml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_accent_todo" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_card_bg" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
