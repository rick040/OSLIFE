<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle round tap target for header icon buttons (refresh) — a faint
     neutral circle instead of a fully transparent (invisible) hit area,
     with a ripple on press. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/widget_ripple">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_ghost_bg" />
        </shape>
    </item>
</ripple>
