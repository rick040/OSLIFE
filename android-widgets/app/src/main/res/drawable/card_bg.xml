<?xml version="1.0" encoding="utf-8"?>
<!-- Shared dark-glass card — translucent so it blends with the home-screen
     wallpaper the way the OS's own widgets do, large native corner radius,
     no per-widget spine or icon badge. Color/identity comes from a small
     accent used on progress bars / tag text only. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_card_bg" />
    <corners android:radius="28dp" />
</shape>
