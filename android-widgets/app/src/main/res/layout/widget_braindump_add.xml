<?xml version="1.0" encoding="utf-8"?>
<!-- Brain-dump: today's capture count, then three big shortcuts — type, speak, upload. The shortcuts stay usable in every state (captures queue offline), only the count depends on the network. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@android:id/background" style="@style/WidgetBackground" />

    <LinearLayout style="@style/WidgetBody">

        <LinearLayout style="@style/WidgetHeader">
            <ImageView style="@style/WidgetHeaderIcon" android:src="@drawable/ic_w_bulb" android:tint="@color/widget_accent_braindump" />
            <TextView style="@style/WidgetTitle" android:text="Brain-dump" />
            <ImageView android:id="@+id/widget_refresh" style="@style/WidgetRefresh" />
        </LinearLayout>

        <TextView android:id="@+id/widget_empty" style="@style/WidgetEmpty" />

        <LinearLayout android:id="@+id/widget_content" style="@style/WidgetContent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp">
            <TextView android:id="@+id/widget_count_today" style="@style/WidgetText.Hero" />
            <TextView android:id="@+id/widget_caption" style="@style/WidgetText.Secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="vandaag vastgelegd" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="6dp" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp">
            <LinearLayout android:id="@+id/widget_shortcut_chat" style="@style/WidgetShortcut">
                <ImageView style="@style/WidgetShortcutIcon" android:src="@drawable/ic_w_pencil" android:tint="@color/widget_accent_braindump" />
                <TextView style="@style/WidgetShortcutLabel" android:text="Typen" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_shortcut_talk" style="@style/WidgetShortcut" android:layout_marginStart="6dp">
                <ImageView style="@style/WidgetShortcutIcon" android:src="@drawable/ic_w_mic" android:tint="@color/widget_accent_braindump" />
                <TextView style="@style/WidgetShortcutLabel" android:text="Inspreken" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_shortcut_upload" style="@style/WidgetShortcut" android:layout_marginStart="6dp">
                <ImageView style="@style/WidgetShortcutIcon" android:src="@drawable/ic_w_upload" android:tint="@color/widget_accent_braindump" />
                <TextView style="@style/WidgetShortcutLabel" android:text="Upload" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/WidgetFooterRow"
            android:visibility="gone">
            <TextView android:id="@+id/widget_updated" style="@style/WidgetFooter" />
            <TextView android:id="@+id/widget_more" style="@style/WidgetMore" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
