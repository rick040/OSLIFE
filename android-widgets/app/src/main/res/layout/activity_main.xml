<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home-screen widgets voor OSLIFE: Vandaag, Snelle acties, To-do, Belangrijkste, Projecten, Brain-dump, HEYRA, Gezondheid, Financiën, Inbox en Agenda."
            android:textSize="13sp"
            android:alpha="0.7"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eén basis-URL en secret voor alle widgets — elke widget haalt zijn eigen edge function op onder deze URL."
            android:textSize="12sp"
            android:alpha="0.7"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Functions base URL"
            android:textSize="12sp"
            android:alpha="0.7" />
        <EditText
            android:id="@+id/oslifeBaseUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://xxxx.supabase.co/functions/v1"
            android:inputType="textUri" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Widget secret"
            android:textSize="12sp"
            android:alpha="0.7"
            android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/oslifeSecretInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="WIDGET_SUMMARY_SECRET waarde"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OSLIFE web app URL (voor 'open in OSLIFE' vanuit een widget)"
            android:textSize="12sp"
            android:alpha="0.7"
            android:layout_marginTop="8dp" />
        <EditText
            android:id="@+id/oslifeWebAppUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://oslife-iota.vercel.app"
            android:inputType="textUri" />

        <Button
            android:id="@+id/saveOslifeSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Opslaan en verbinding testen" />

        <TextView
            android:id="@+id/connectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/refreshOslifeWidgetsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Alle widgets nu verversen" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Long-press het homescreen → Widgets → OSLIFE Widgets om ze toe te voegen. Long-press een geplaatste widget → Widget aanpassen om de achtergrond doorzichtiger te maken."
            android:textSize="12sp"
            android:alpha="0.7" />

    </LinearLayout>
</ScrollView>
