<?xml version="1.0" encoding="utf-8"?>
<!-- Snelle acties: a slim 4x1 bar with the five things worth one tap from the home screen —
     capture (type/speak/upload), ask HEYRA, open OSLIFE. Static, no network. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@android:id/background" style="@style/WidgetBackground" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp">
        <LinearLayout android:id="@+id/widget_action_note" style="@style/WidgetShortcut" android:background="@drawable/widget_ripple">
            <ImageView style="@style/WidgetShortcutIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_w_pencil" android:tint="@color/widget_accent_braindump" />
            <TextView style="@style/WidgetShortcutLabel" android:layout_marginTop="3dp" android:textSize="10sp" android:text="Notitie" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_action_voice" style="@style/WidgetShortcut" android:background="@drawable/widget_ripple" android:layout_marginStart="4dp">
            <ImageView style="@style/WidgetShortcutIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_w_mic" android:tint="@color/widget_accent_braindump" />
            <TextView style="@style/WidgetShortcutLabel" android:layout_marginTop="3dp" android:textSize="10sp" android:text="Inspreken" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_action_heyra" style="@style/WidgetShortcut" android:background="@drawable/widget_ripple" android:layout_marginStart="4dp">
            <ImageView style="@style/WidgetShortcutIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_w_sparkles" android:tint="@color/widget_accent_heyra" />
            <TextView style="@style/WidgetShortcutLabel" android:layout_marginTop="3dp" android:textSize="10sp" android:text="HEYRA" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_action_upload" style="@style/WidgetShortcut" android:background="@drawable/widget_ripple" android:layout_marginStart="4dp">
            <ImageView style="@style/WidgetShortcutIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_w_upload" android:tint="@color/widget_accent_braindump" />
            <TextView style="@style/WidgetShortcutLabel" android:layout_marginTop="3dp" android:textSize="10sp" android:text="Upload" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_action_open" style="@style/WidgetShortcut" android:background="@drawable/widget_ripple" android:layout_marginStart="4dp">
            <ImageView style="@style/WidgetShortcutIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_w_home" android:tint="@color/widget_text_primary" />
            <TextView style="@style/WidgetShortcutLabel" android:layout_marginTop="3dp" android:textSize="10sp" android:text="OSLIFE" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
