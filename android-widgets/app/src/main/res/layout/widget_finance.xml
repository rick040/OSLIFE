<?xml version="1.0" encoding="utf-8"?>
<!-- Financiën: balance as the hero number (red when negative), then open payments and — only when there are any — urgent ones, as stacked icon lines that never wrap or clip. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@android:id/background" style="@style/WidgetBackground" />

    <LinearLayout style="@style/WidgetBody">

        <LinearLayout style="@style/WidgetHeader">
            <ImageView style="@style/WidgetHeaderIcon" android:src="@drawable/ic_w_wallet" android:tint="@color/widget_accent_finance" />
            <TextView style="@style/WidgetTitle" android:text="Financiën" />
            <ImageView android:id="@+id/widget_refresh" style="@style/WidgetRefresh" />
        </LinearLayout>

        <TextView android:id="@+id/widget_empty" style="@style/WidgetEmpty" />

        <LinearLayout android:id="@+id/widget_content" style="@style/WidgetContent" android:paddingStart="10dp" android:paddingEnd="10dp">
            <TextView android:id="@+id/widget_balance" style="@style/WidgetText.Hero" />
            <TextView android:id="@+id/widget_balance_asof" style="@style/WidgetText.Meta" android:layout_marginTop="2dp" />
            <!-- Flexible gap (a FrameLayout: a bare View is not RemoteViews-inflatable) -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="8dp" />
            <TextView android:id="@+id/widget_open_payments" style="@style/WidgetText.Stat" android:drawableStart="@drawable/ic_w_receipt_sm" android:drawableTint="@color/widget_accent_finance" />
            <TextView android:id="@+id/widget_urgent" style="@style/WidgetText.Stat" android:layout_marginTop="6dp" android:textColor="@color/widget_danger" android:drawableStart="@drawable/ic_w_alert_sm" android:drawableTint="@color/widget_danger" android:visibility="gone" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetFooterRow">
            <TextView android:id="@+id/widget_updated" style="@style/WidgetFooter" />
            <TextView android:id="@+id/widget_more" style="@style/WidgetMore" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
