<?xml version="1.0" encoding="utf-8"?>
<!-- To-do: every open task as a tappable row — the ring is the checkbox (color = priority), the row opens the task. Rows beyond what fits are hidden per instance (WidgetStyle.rowCapacity) and counted in the footer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@android:id/background" style="@style/WidgetBackground" />

    <LinearLayout style="@style/WidgetBody">

        <LinearLayout style="@style/WidgetHeader">
            <ImageView style="@style/WidgetHeaderIcon" android:src="@drawable/ic_w_list" android:tint="@color/widget_accent_todo" />
            <TextView style="@style/WidgetTitle" android:text="To-do" />
            <TextView android:id="@+id/widget_count" style="@style/WidgetCountBadge" android:textColor="@color/widget_accent_todo" />
            <ImageView android:id="@+id/widget_refresh" style="@style/WidgetRefresh" />
        </LinearLayout>

        <TextView android:id="@+id/widget_empty" style="@style/WidgetEmpty" />

        <LinearLayout android:id="@+id/widget_content" style="@style/WidgetContent">
            <LinearLayout android:id="@+id/widget_row1" style="@style/WidgetTaskRow">
                <ImageView android:id="@+id/widget_check1" style="@style/WidgetTaskCheck" />
                <TextView android:id="@+id/widget_title1" style="@style/WidgetTaskTitle" />
                <TextView android:id="@+id/widget_due1" style="@style/WidgetPill" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row2" style="@style/WidgetTaskRow">
                <ImageView android:id="@+id/widget_check2" style="@style/WidgetTaskCheck" />
                <TextView android:id="@+id/widget_title2" style="@style/WidgetTaskTitle" />
                <TextView android:id="@+id/widget_due2" style="@style/WidgetPill" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row3" style="@style/WidgetTaskRow">
                <ImageView android:id="@+id/widget_check3" style="@style/WidgetTaskCheck" />
                <TextView android:id="@+id/widget_title3" style="@style/WidgetTaskTitle" />
                <TextView android:id="@+id/widget_due3" style="@style/WidgetPill" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row4" style="@style/WidgetTaskRow">
                <ImageView android:id="@+id/widget_check4" style="@style/WidgetTaskCheck" />
                <TextView android:id="@+id/widget_title4" style="@style/WidgetTaskTitle" />
                <TextView android:id="@+id/widget_due4" style="@style/WidgetPill" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row5" style="@style/WidgetTaskRow">
                <ImageView android:id="@+id/widget_check5" style="@style/WidgetTaskCheck" />
                <TextView android:id="@+id/widget_title5" style="@style/WidgetTaskTitle" />
                <TextView android:id="@+id/widget_due5" style="@style/WidgetPill" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row6" style="@style/WidgetTaskRow">
                <ImageView android:id="@+id/widget_check6" style="@style/WidgetTaskCheck" />
                <TextView android:id="@+id/widget_title6" style="@style/WidgetTaskTitle" />
                <TextView android:id="@+id/widget_due6" style="@style/WidgetPill" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row7" style="@style/WidgetTaskRow">
                <ImageView android:id="@+id/widget_check7" style="@style/WidgetTaskCheck" />
                <TextView android:id="@+id/widget_title7" style="@style/WidgetTaskTitle" />
                <TextView android:id="@+id/widget_due7" style="@style/WidgetPill" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row8" style="@style/WidgetTaskRow">
                <ImageView android:id="@+id/widget_check8" style="@style/WidgetTaskCheck" />
                <TextView android:id="@+id/widget_title8" style="@style/WidgetTaskTitle" />
                <TextView android:id="@+id/widget_due8" style="@style/WidgetPill" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/WidgetFooterRow">
            <TextView android:id="@+id/widget_updated" style="@style/WidgetFooter" />
            <TextView android:id="@+id/widget_more" style="@style/WidgetMore" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
