<?xml version="1.0" encoding="utf-8"?>
<!-- Agenda: today's remaining blocks with a Google-Calendar-style color bar; the block that is happening now is highlighted ("Nu · tot 11:30"). The date in the header is a TextClock, so it never goes stale. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@android:id/background" style="@style/WidgetBackground" />

    <LinearLayout style="@style/WidgetBody">

        <LinearLayout style="@style/WidgetHeader">
            <ImageView style="@style/WidgetHeaderIcon" android:src="@drawable/ic_w_calendar" android:tint="@color/widget_accent_calendar" />
            <TextView style="@style/WidgetTitle" android:text="Agenda" />
            <TextClock style="@style/WidgetText.Meta" android:format12Hour="EEE d MMM" android:format24Hour="EEE d MMM" />
            <ImageView android:id="@+id/widget_refresh" style="@style/WidgetRefresh" />
        </LinearLayout>

        <TextView android:id="@+id/widget_empty" style="@style/WidgetEmpty" />

        <LinearLayout android:id="@+id/widget_content" style="@style/WidgetContent">
            <LinearLayout android:id="@+id/widget_row1" style="@style/WidgetRow" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
                <ImageView android:id="@+id/widget_bar1" android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/calendar_bar" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:id="@+id/widget_title1" style="@style/WidgetText.Body" android:layout_width="match_parent" />
                    <TextView android:id="@+id/widget_time1" style="@style/WidgetText.Meta" android:layout_width="match_parent" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row2" style="@style/WidgetRow" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
                <ImageView android:id="@+id/widget_bar2" android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/calendar_bar" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:id="@+id/widget_title2" style="@style/WidgetText.Body" android:layout_width="match_parent" />
                    <TextView android:id="@+id/widget_time2" style="@style/WidgetText.Meta" android:layout_width="match_parent" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row3" style="@style/WidgetRow" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
                <ImageView android:id="@+id/widget_bar3" android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/calendar_bar" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:id="@+id/widget_title3" style="@style/WidgetText.Body" android:layout_width="match_parent" />
                    <TextView android:id="@+id/widget_time3" style="@style/WidgetText.Meta" android:layout_width="match_parent" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row4" style="@style/WidgetRow" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
                <ImageView android:id="@+id/widget_bar4" android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/calendar_bar" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:id="@+id/widget_title4" style="@style/WidgetText.Body" android:layout_width="match_parent" />
                    <TextView android:id="@+id/widget_time4" style="@style/WidgetText.Meta" android:layout_width="match_parent" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row5" style="@style/WidgetRow" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
                <ImageView android:id="@+id/widget_bar5" android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/calendar_bar" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:id="@+id/widget_title5" style="@style/WidgetText.Body" android:layout_width="match_parent" />
                    <TextView android:id="@+id/widget_time5" style="@style/WidgetText.Meta" android:layout_width="match_parent" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row6" style="@style/WidgetRow" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
                <ImageView android:id="@+id/widget_bar6" android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/calendar_bar" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:id="@+id/widget_title6" style="@style/WidgetText.Body" android:layout_width="match_parent" />
                    <TextView android:id="@+id/widget_time6" style="@style/WidgetText.Meta" android:layout_width="match_parent" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row7" style="@style/WidgetRow" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
                <ImageView android:id="@+id/widget_bar7" android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/calendar_bar" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:id="@+id/widget_title7" style="@style/WidgetText.Body" android:layout_width="match_parent" />
                    <TextView android:id="@+id/widget_time7" style="@style/WidgetText.Meta" android:layout_width="match_parent" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row8" style="@style/WidgetRow" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
                <ImageView android:id="@+id/widget_bar8" android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/calendar_bar" android:scaleType="fitXY" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                    <TextView android:id="@+id/widget_title8" style="@style/WidgetText.Body" android:layout_width="match_parent" />
                    <TextView android:id="@+id/widget_time8" style="@style/WidgetText.Meta" android:layout_width="match_parent" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/WidgetFooterRow">
            <TextView android:id="@+id/widget_updated" style="@style/WidgetFooter" />
            <TextView android:id="@+id/widget_more" style="@style/WidgetMore" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
