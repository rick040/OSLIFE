<?xml version="1.0" encoding="utf-8"?>
<!-- Gezondheid: steps as the hero number with a progress bar to the daily goal, then sleep / weight / habits / streak as a 2x2 grid of icon stats — fits a 2x2 widget without clipping. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@android:id/background" style="@style/WidgetBackground" />

    <LinearLayout style="@style/WidgetBody">

        <LinearLayout style="@style/WidgetHeader">
            <ImageView style="@style/WidgetHeaderIcon" android:src="@drawable/ic_w_heart" android:tint="@color/widget_accent_health" />
            <TextView style="@style/WidgetTitle" android:text="Gezondheid" />
            <ImageView android:id="@+id/widget_refresh" style="@style/WidgetRefresh" />
        </LinearLayout>

        <TextView android:id="@+id/widget_empty" style="@style/WidgetEmpty" />

        <LinearLayout android:id="@+id/widget_content" style="@style/WidgetContent" android:paddingStart="10dp" android:paddingEnd="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
                <TextView android:id="@+id/widget_steps" style="@style/WidgetText.Hero" />
                <TextView android:id="@+id/widget_steps_goal" style="@style/WidgetText.Meta" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginBottom="2dp" />
            </LinearLayout>
            <ProgressBar android:id="@+id/widget_steps_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_progress_fill_health" />
            <!-- Flexible gap (a FrameLayout: a bare View is not RemoteViews-inflatable) -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/widget_sleep" style="@style/WidgetText.Stat" android:layout_width="0dp" android:layout_weight="1" android:drawableStart="@drawable/ic_w_moon_sm" android:drawableTint="@color/widget_accent_finance" />
                <TextView android:id="@+id/widget_weight" style="@style/WidgetText.Stat" android:layout_width="0dp" android:layout_weight="1" android:drawableStart="@drawable/ic_w_weight_sm" android:drawableTint="@color/widget_accent_inbox" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                <TextView android:id="@+id/widget_habits" style="@style/WidgetText.Stat" android:layout_width="0dp" android:layout_weight="1" android:drawableStart="@drawable/ic_w_check_circle_sm" android:drawableTint="@color/widget_done" />
                <TextView android:id="@+id/widget_streak" style="@style/WidgetText.Stat" android:layout_width="0dp" android:layout_weight="1" android:drawableStart="@drawable/ic_w_flame_sm" android:drawableTint="@color/widget_accent_calendar" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/WidgetFooterRow">
            <TextView android:id="@+id/widget_updated" style="@style/WidgetFooter" />
            <TextView android:id="@+id/widget_more" style="@style/WidgetMore" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
