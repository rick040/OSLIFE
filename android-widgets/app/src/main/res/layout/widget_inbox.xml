<?xml version="1.0" encoding="utf-8"?>
<!-- Inbox: unread count in the header, newest unread mails Gmail-style (sender + time, subject, snippet). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@android:id/background" style="@style/WidgetBackground" />

    <LinearLayout style="@style/WidgetBody">

        <LinearLayout style="@style/WidgetHeader">
            <ImageView style="@style/WidgetHeaderIcon" android:src="@drawable/ic_w_mail" android:tint="@color/widget_accent_inbox" />
            <TextView style="@style/WidgetTitle" android:text="Inbox" />
            <TextView android:id="@+id/widget_count" style="@style/WidgetCountBadge" android:textColor="@color/widget_accent_inbox" />
            <ImageView android:id="@+id/widget_refresh" style="@style/WidgetRefresh" />
        </LinearLayout>

        <TextView android:id="@+id/widget_empty" style="@style/WidgetEmpty" />

        <LinearLayout android:id="@+id/widget_content" style="@style/WidgetContent">
            <LinearLayout android:id="@+id/widget_row1" style="@style/WidgetRow">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/widget_from1" style="@style/WidgetText.Strong" android:layout_width="0dp" android:layout_weight="1" android:textSize="13sp" />
                    <TextView android:id="@+id/widget_time1" style="@style/WidgetText.Meta" android:layout_marginStart="8dp" />
                </LinearLayout>
                <TextView android:id="@+id/widget_subject1" style="@style/WidgetText.Secondary" android:layout_width="match_parent" android:textColor="@color/widget_text_primary" />
                <TextView android:id="@+id/widget_snippet1" style="@style/WidgetText.Meta" android:layout_width="match_parent" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row2" style="@style/WidgetRow">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/widget_from2" style="@style/WidgetText.Strong" android:layout_width="0dp" android:layout_weight="1" android:textSize="13sp" />
                    <TextView android:id="@+id/widget_time2" style="@style/WidgetText.Meta" android:layout_marginStart="8dp" />
                </LinearLayout>
                <TextView android:id="@+id/widget_subject2" style="@style/WidgetText.Secondary" android:layout_width="match_parent" android:textColor="@color/widget_text_primary" />
                <TextView android:id="@+id/widget_snippet2" style="@style/WidgetText.Meta" android:layout_width="match_parent" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row3" style="@style/WidgetRow">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/widget_from3" style="@style/WidgetText.Strong" android:layout_width="0dp" android:layout_weight="1" android:textSize="13sp" />
                    <TextView android:id="@+id/widget_time3" style="@style/WidgetText.Meta" android:layout_marginStart="8dp" />
                </LinearLayout>
                <TextView android:id="@+id/widget_subject3" style="@style/WidgetText.Secondary" android:layout_width="match_parent" android:textColor="@color/widget_text_primary" />
                <TextView android:id="@+id/widget_snippet3" style="@style/WidgetText.Meta" android:layout_width="match_parent" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row4" style="@style/WidgetRow">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/widget_from4" style="@style/WidgetText.Strong" android:layout_width="0dp" android:layout_weight="1" android:textSize="13sp" />
                    <TextView android:id="@+id/widget_time4" style="@style/WidgetText.Meta" android:layout_marginStart="8dp" />
                </LinearLayout>
                <TextView android:id="@+id/widget_subject4" style="@style/WidgetText.Secondary" android:layout_width="match_parent" android:textColor="@color/widget_text_primary" />
                <TextView android:id="@+id/widget_snippet4" style="@style/WidgetText.Meta" android:layout_width="match_parent" />
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_row5" style="@style/WidgetRow">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/widget_from5" style="@style/WidgetText.Strong" android:layout_width="0dp" android:layout_weight="1" android:textSize="13sp" />
                    <TextView android:id="@+id/widget_time5" style="@style/WidgetText.Meta" android:layout_marginStart="8dp" />
                </LinearLayout>
                <TextView android:id="@+id/widget_subject5" style="@style/WidgetText.Secondary" android:layout_width="match_parent" android:textColor="@color/widget_text_primary" />
                <TextView android:id="@+id/widget_snippet5" style="@style/WidgetText.Meta" android:layout_width="match_parent" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/WidgetFooterRow">
            <TextView android:id="@+id/widget_updated" style="@style/WidgetFooter" />
            <TextView android:id="@+id/widget_more" style="@style/WidgetMore" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
