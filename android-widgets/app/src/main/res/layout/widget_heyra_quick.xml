<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_card_heyra">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/chip_heyra">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:tint="@android:color/white"
                android:src="@drawable/ic_chat"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="HEYRA"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/widget_text_primary" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:text="Tik om iets te vragen, of spreek direct in"
        android:textSize="13sp"
        android:textColor="@color/widget_text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Snelle vraag →"
            android:textSize="11sp"
            android:textColor="@color/widget_text_tertiary" />

        <FrameLayout
            android:id="@+id/widget_mic_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/chip_heyra">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:tint="@android:color/white"
                android:src="@drawable/ic_mic"
                android:contentDescription="Spreek met HEYRA" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
