<?xml version="1.0" encoding="utf-8"?>
<!-- HEYRA: static launcher — the card or the wide button opens the quick chat, the round mic starts listening straight away. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView android:id="@android:id/background" style="@style/WidgetBackground" />

    <LinearLayout style="@style/WidgetBody">

        <LinearLayout style="@style/WidgetHeader">
            <ImageView style="@style/WidgetHeaderIcon" android:src="@drawable/ic_w_sparkles" android:tint="@color/widget_accent_heyra" />
            <TextView style="@style/WidgetTitle" android:text="HEYRA" />
        </LinearLayout>

        <TextView android:id="@+id/widget_empty" style="@style/WidgetEmpty" />

        <TextView style="@style/WidgetText.Secondary" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:maxLines="2" android:text="Stel een vraag, of spreek direct in." />

        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp">
            <LinearLayout android:id="@+id/widget_chat_button" style="@style/WidgetShortcut" android:orientation="horizontal">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_w_chat" android:tint="@color/widget_accent_heyra" android:importantForAccessibility="no" />
                <TextView style="@style/WidgetShortcutLabel" android:layout_marginTop="0dp" android:layout_marginStart="8dp" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_text_primary" android:text="Chat" />
            </LinearLayout>
            <FrameLayout android:id="@+id/widget_mic_button" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:background="@drawable/glass_button_bg" android:contentDescription="Spreek met HEYRA">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_w_mic" android:tint="@color/widget_accent_heyra" android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
