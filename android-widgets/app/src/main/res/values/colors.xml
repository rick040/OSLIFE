    <!-- ── Native widget design system (v3) ──────────────────────────────────
         Dark glass card (translucent, blends with the home-screen wallpaper
         the way the OS's own widgets do — see the "Stappen" reference), no
         icon badges, bold light typography. One accent color per widget used
         only for progress bars / small tag text, never for backgrounds. -->
    <color name="widget_card_bg">#CC15151A</color>
    <color name="widget_text_primary">#FFFFFF</color>
    <color name="widget_text_secondary">#B0B4BD</color>
    <color name="widget_text_tertiary">#7D8189</color>
    <color name="widget_divider">#26FFFFFF</color>

    <color name="widget_accent_todo">#5B9BFF</color>
    <color name="widget_accent_priority">#FBBF24</color>
    <color name="widget_accent_projects">#A78BFA</color>
    <color name="widget_accent_braindump">#34D399</color>
    <color name="widget_accent_heyra">#2DD4BF</color>
    <color name="widget_accent_health">#FB7185</color>
    <color name="widget_accent_finance">#818CF8</color>
    <color name="widget_accent_inbox">#38BDF8</color>
    <color name="widget_accent_calendar">#FB923C</color>

    <color name="widget_danger">#FF6B6B</color>
