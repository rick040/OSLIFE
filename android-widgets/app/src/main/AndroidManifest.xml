<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.OslifeWidgets"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Listed first so they top the widget picker: the day overview and the action bar. -->
        <receiver
            android:name=".widget.today.TodayWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="nl.oslife.widgets.widget.today.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <receiver
            android:name=".widget.quickactions.QuickActionsWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label_quick_actions">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_actions_info" />
        </receiver>

        <receiver
            android:name=".widget.todo.TodoListWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label_todo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="nl.oslife.widgets.widget.todo.ACTION_REFRESH" />
                <action android:name="nl.oslife.widgets.widget.todo.ACTION_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_todo_list_info" />
        </receiver>

        <receiver
            android:name=".widget.priority.TopPriorityWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label_priority">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="nl.oslife.widgets.widget.priority.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_top_priority_info" />
        </receiver>

        <receiver
            android:name=".widget.projects.ActiveProjectsWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label_projects">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="nl.oslife.widgets.widget.projects.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_active_projects_info" />
        </receiver>

        <receiver
            android:name=".widget.braindump.BraindumpQuickAddWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label_braindump">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="nl.oslife.widgets.widget.braindump.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_braindump_add_info" />
        </receiver>

        <activity
            android:name=".widget.braindump.QuickAddActivity"
            android:exported="false"
            android:theme="@style/Theme.OslifeWidgets.Overlay"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <activity
            android:name=".widget.braindump.BraindumpUploadActivity"
            android:exported="false"
            android:theme="@style/Theme.OslifeWidgets.Overlay"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <receiver
            android:name=".widget.heyra.HeyraQuickWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label_heyra">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_heyra_quick_info" />
        </receiver>

        <activity
            android:name=".widget.heyra.HeyraQuickChatActivity"
            android:exported="false"
            android:theme="@style/Theme.OslifeWidgets.Overlay"
            android:excludeFromRecents="true"
            android:launchMode="singleTask" />

        <receiver
            android:name=".widget.health.HealthWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label_health">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="nl.oslife.widgets.widget.health.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_health_info" />
        </receiver>

        <receiver
            android:name=".widget.finance.FinanceWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label_finance">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="nl.oslife.widgets.widget.finance.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_finance_info" />
        </receiver>

        <receiver
            android:name=".widget.inbox.InboxWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label_inbox">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="nl.oslife.widgets.widget.inbox.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_inbox_info" />
        </receiver>

        <receiver
            android:name=".widget.calendar.CalendarWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label_calendar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="nl.oslife.widgets.widget.calendar.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calendar_info" />
        </receiver>

        <activity
            android:name=".widget.common.WidgetConfigureActivity"
            android:exported="true"
            android:theme="@style/Theme.OslifeWidgets.Overlay"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>

</manifest>
